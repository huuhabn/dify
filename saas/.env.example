# ==============================================================================
# Dify AI Agents SaaS - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js & Application Config
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEPLOY_ENV=DEVELOPMENT
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_PATH=
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LOGGING_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Dify Backend API Integration
# ------------------------------------------------------------------------------
# Server-only console API origin for SSR/Server Components requests
CONSOLE_API_URL=http://localhost:5001

# Base URL of console application API for Client Components
NEXT_PUBLIC_API_PREFIX=http://localhost:5001/console/api

# Base URL of public WebApp API
NEXT_PUBLIC_PUBLIC_API_PREFIX=http://localhost:5001/api

# WebSocket Server URL for live updates / chatflow
NEXT_PUBLIC_SOCKET_URL=ws://localhost:5001

# Cookie domain setting (keep empty for localhost; set if frontend/backend are on different subdomains)
NEXT_PUBLIC_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 3. Dify Marketplace Integration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MARKETPLACE_API_PREFIX=https://marketplace.dify.ai/api/v1
NEXT_PUBLIC_MARKETPLACE_URL_PREFIX=https://marketplace.dify.ai

# ------------------------------------------------------------------------------
# 4. Database Config (Drizzle ORM & PGLite Demo)
# ------------------------------------------------------------------------------
# Connection string for Postgres (default connects to local pglite-server on port 5432)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# ------------------------------------------------------------------------------
# 5. Core Application Features & Limits
# ------------------------------------------------------------------------------
# Enable Agent v2 frontend entry points
NEXT_PUBLIC_ENABLE_AGENT_V2=true
NEXT_PUBLIC_ENABLE_AGENT_V2_IN_CHATFLOW=false

# Enable HITL (Human-in-the-loop) IM and Contacts
NEXT_PUBLIC_ENABLE_HITL_IM=true

# Preview features in "Go to Anything" command palette (/create, /refine)
NEXT_PUBLIC_ENABLE_FEATURE_PREVIEW=true

# Web scrapers integration
NEXT_PUBLIC_ENABLE_WEBSITE_JINAREADER=true
NEXT_PUBLIC_ENABLE_WEBSITE_FIRECRAWL=true
NEXT_PUBLIC_ENABLE_WEBSITE_WATERCRAWL=true

# Workflow timeouts (milliseconds)
NEXT_PUBLIC_TEXT_GENERATION_TIMEOUT_MS=60000
NEXT_PUBLIC_WORKFLOW_GENERATION_TIMEOUT_MS=180000

# Workflow constraints
NEXT_PUBLIC_LOOP_NODE_MAX_COUNT=100
NEXT_PUBLIC_MAX_TOOLS_NUM=10
NEXT_PUBLIC_MAX_PARALLEL_LIMIT=10
NEXT_PUBLIC_MAX_ITERATIONS_NUM=99
NEXT_PUBLIC_MAX_TREE_DEPTH=50
NEXT_PUBLIC_BATCH_CONCURRENCY=5

# Knowledge base / RAG settings
NEXT_PUBLIC_TOP_K_MAX_VALUE=10
NEXT_PUBLIC_INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH=4000

# ------------------------------------------------------------------------------
# 6. Optional Security & Monitoring
# ------------------------------------------------------------------------------
# Arcjet Bot Detection (Optional)
# ARCJET_KEY=

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Reporting (Optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORGANIZATION=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
