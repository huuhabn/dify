# ==============================================================================
# Dify AI Agents SaaS - Production Environment Variables
# ==============================================================================

# Application Config
NEXT_PUBLIC_DEPLOY_ENV=PRODUCTION
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_BASE_PATH=
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LOGGING_LEVEL=info

# Dify Backend API Integration
CONSOLE_API_URL=https://your-domain.com
NEXT_PUBLIC_API_PREFIX=https://your-domain.com/console/api
NEXT_PUBLIC_PUBLIC_API_PREFIX=https://your-domain.com/api
NEXT_PUBLIC_SOCKET_URL=wss://your-domain.com
NEXT_PUBLIC_COOKIE_DOMAIN=

# Dify Marketplace Integration
NEXT_PUBLIC_MARKETPLACE_API_PREFIX=https://marketplace.dify.ai/api/v1
NEXT_PUBLIC_MARKETPLACE_URL_PREFIX=https://marketplace.dify.ai

# Database Config (Postgres Production)
DATABASE_URL=postgresql://postgres:password@your-postgres-host:5432/postgres

# Feature Flags
NEXT_PUBLIC_ENABLE_AGENT_V2=true
NEXT_PUBLIC_ENABLE_AGENT_V2_IN_CHATFLOW=false
NEXT_PUBLIC_ENABLE_HITL_IM=true
NEXT_PUBLIC_ENABLE_FEATURE_PREVIEW=false
NEXT_PUBLIC_ENABLE_WEBSITE_JINAREADER=true
NEXT_PUBLIC_ENABLE_WEBSITE_FIRECRAWL=true
NEXT_PUBLIC_ENABLE_WEBSITE_WATERCRAWL=true
